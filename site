<script>
/* ==================== DATA ==================== */
const DEFAULT_PASS = 'love123';
/* ==================== ONLINE DB (JSONBin) ==================== */
const JB = {
  url: () => `https://api.jsonbin.io/v3/b/${window.JB_CONFIG.BIN_ID}`,
  headers: () => ({
    'Content-Type': 'application/json',
    'X-Access-Key': window.JB_CONFIG.KEY
  }),
  async load() {
    try {
      const r = await fetch(this.url() + '/latest', { headers: this.headers() });
      if (!r.ok) throw new Error('load failed');
      const d = await r.json();
      return d.record || {};
    } catch(e) { console.warn('JB load error:', e); return null; }
  },
  async save(data) {
    try {
      const r = await fetch(this.url(), {
        method: 'PUT',
        headers: this.headers(),
        body: JSON.stringify(data)
      });
      return r.ok;
    } catch(e) { console.warn('JB save error:', e); return false; }
  }
};

let onlineReady = false;
let onlineData = { singles: [], partners: [], messages: [], music: [], anime: [], files: [] };

async function initOnline() {
  const d = await JB.load();
  if (!d) { console.log('اتصال ناموفق'); return; }
  onlineData = Object.assign(onlineData, d);
  if (Array.isArray(d.singles)) singles = d.singles;
  if (Array.isArray(d.partners)) D.partner = d.partners;
  if (Array.isArray(d.messages) && d.messages.length) messages = d.messages;
  if (Array.isArray(d.music)) D.music = d.music;
  if (Array.isArray(d.anime)) D.anime = d.anime;
  if (Array.isArray(d.files)) D.file = d.files;
  onlineReady = true;
  try {
    renderSingles();
    renderList('partner'); renderList('music'); renderList('anime'); renderList('file');
    if (typeof renderAdminMessages === 'function') renderAdminMessages();
    if (typeof renderAdminSingles === 'function') renderAdminSingles();
    if (typeof updateAdminStats === 'function') updateAdminStats();
  } catch(e) { console.warn(e); }
  console.log('✅ آنلاین آماده شد');
}

let onlineSyncChain = Promise.resolve();
async function syncOnline() {
  /* Never let a local-only mutation silently stop at localStorage. */
  if (!onlineReady) {
    await initOnline();
    if (!onlineReady) return false;
  }
  onlineData.singles = Array.isArray(singles) ? singles : [];
  onlineData.partners = Array.isArray(D.partner) ? D.partner : [];
  onlineData.messages = Array.isArray(messages) ? messages : [];
  onlineData.music = Array.isArray(D.music) ? D.music : [];
  onlineData.anime = Array.isArray(D.anime) ? D.anime : [];
  onlineData.files = Array.isArray(D.file) ? D.file : [];
  onlineSyncChain = onlineSyncChain.catch(() => false).then(() => JB.save({...onlineData}));
  const ok = await onlineSyncChain;
  console.log(ok ? '✅ آنلاین همگام شد' : '❌ خطا در همگام‌سازی آنلاین');
  return ok;
}

