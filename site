let speedIndex = 0, speedScore = 0, speedTime = 15;
let speedTimer = null, speedRunning = false;

function startSpeedQuiz() {
  speedIndex = 0; speedScore = 0; speedTime = 15;
  speedRunning = true;
  clearInterval(speedTimer);
  $('speedStatus').textContent = '';
  $('speedTimer').textContent = speedTime;
  $('speedTimer').classList.remove('warning');
  speedTimer = setInterval(() => {
    speedTime--;
    $('speedTimer').textContent = speedTime;
    if (speedTime <= 5) $('speedTimer').classList.add('warning');
    if (speedTime <= 0) endSpeedQuiz();
  }, 1000);
  showSpeedQuestion();
}
function showSpeedQuestion() {
  if (speedIndex >= SPEED_QUESTIONS.length) { endSpeedQuiz(); return; }
  const q = SPEED_QUESTIONS[speedIndex];
  $('speedQ').textContent = q.q;
  $('speedOpts').innerHTML = q.opts.map((o, i) =>
    `<button class="speed-opt" onclick="speedAnswer(${i})">${o}</button>`
  ).join('');
}
function speedAnswer(i) {
  if (!speedRunning) return;
  const q = SPEED_QUESTIONS[speedIndex];
  const opts = document.querySelectorAll('.speed-opt');
  opts.forEach(o => o.style.pointerEvents = 'none');
  if (i === q.a) {
    opts[i].classList.add('correct');
    speedScore++;
  } else {
    opts[i].classList.add('wrong');
    opts[q.a].classList.add('correct');
  }
  setTimeout(() => { speedIndex++; showSpeedQuestion(); }, 700);
}
