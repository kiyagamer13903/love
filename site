let currentQ = 0;
const answers = [];
const quizContainer = $('quizContainer');
const progressBar = $('progressBar');
const quizResult = $('quizResult');

function renderQuiz() {
  if (currentQ >= QUIZ_DATA.length) { showResult(); return; }
  const data = QUIZ_DATA[currentQ];
  progressBar.style.width = ((currentQ / QUIZ_DATA.length) * 100) + '%';
  let html = `<div class="quiz-step active">
    <div class="question-num">سوال ${currentQ + 1} از ${QUIZ_DATA.length}</div>
    <div class="question-text">${data.q}</div>
    <div class="options">`;
  data.options.forEach((opt, i) => {
    const isSel = answers[currentQ] === i;
    html += `<button class="option ${isSel ? 'selected' : ''}" onclick="selectOption(${i})">
      <span class="option-letter">${String.fromCharCode(1575 + i)}</span>
      <span>${opt.t}</span>
    </button>`;
  });
  html += `</div><div class="quiz-nav">
    ${currentQ > 0 ? '<button class="btn-quiz btn-back" onclick="prevQ()">قبلی</button>' : '<div></div>'}
    <button class="btn-quiz btn-next" onclick="nextQ()" ${answers[currentQ] === undefined ? 'disabled' : ''}>
      ${currentQ === QUIZ_DATA.length - 1 ? 'دیدن نتیجه' : 'بعدی'}
    </button>
  </div></div>`;
  quizContainer.innerHTML = html;
}
function selectOption(i) { answers[currentQ] = i; renderQuiz(); }
function nextQ() {
  if (answers[currentQ] === undefined) return;
  currentQ++; renderQuiz();
}
function prevQ() {
  if (currentQ > 0) { currentQ--; renderQuiz(); }
}
function showResult() {
  progressBar.style.width = '100%';
  quizContainer.innerHTML = '';
  let total = 0, max = 0;
  answers.forEach((a, i) => { total += QUIZ_DATA[i].options[a].s; max += 5; });
  const percent = Math.round((total / max) * 100);
  let label, message;
  if (percent >= 85) { label = 'عاشقِ تمام‌عیار'; message = 'قلبت یه اقیانوسه. کسی که تو رو داره، خوشبخت‌ترین آدم زمینه.'; }
  else if (percent >= 65) { label = 'عاشق واقعی'; message = 'تو عشق رو می‌فهمی و براش ارزش قائلی. یه قدم دیگه تا کامل شدن فاصله داری.'; }
  else if (percent >= 45) { label = 'در راه عشق'; message = 'دلت آماده‌ست، ولی هنوز یه کم محتاطی. بذار عشق راهش رو به قلبت پیدا کنه.'; }
  else { label = 'قلبِ محتاط'; message = 'شاید هنوز زخم خوردی، شاید هنوز آماده نیستی. ولی عشق واقعی ارزش ریسک کردن رو داره.'; }
  $('resultScore').textContent = percent + '٪';
  $('resultLabel').textContent = label;
  $('resultMessage').textContent = message;
  quizResult.classList.add('active');
}
function restartQuiz() {
  currentQ = 0;
  answers.length = 0;
  quizResult.classList.remove('active');
  progressBar.style.width = '0%';
  renderQuiz();
}
