<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>عشق —Love</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;700;900&family=Playfair+Display:ital,wght@0,600;1,500&display=swap');

  /* ==================== RESET ==================== */
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  /* ==================== THEMES ==================== */
  :root {
    --bg: #fff7f4; --bg2: #ffe9ee; --bg3: #ffd1dc;
    --card: #ffffff; --card2: #fdf2f5;
    --text: #3d1828; --text-soft: #7a4a5c;
    --primary: #e94b6f; --primary-dark: #b8234a; --primary-light: #ff8aa8;
    --accent: #d4a373; --accent-dark: #b8860b;
    --border: #ffd1dc; --border-soft: #ffe9ee;
    --shadow-sm: 0 4px 15px rgba(74,30,46,0.06);
    --shadow: 0 12px 40px rgba(74,30,46,0.10);
    --shadow-lg: 0 25px 70px rgba(74,30,46,0.18);
    --glow: 0 0 40px rgba(233,75,111,0.35);
    --gradient: linear-gradient(135deg, #fff7f4 0%, #ffe9ee 50%, #ffd1dc 100%);
    --gradient-primary: linear-gradient(135deg, #e94b6f, #b8234a);
    --gradient-accent: linear-gradient(135deg, #d4a373, #b8860b);
    --radius-sm: 12px; --radius: 18px; --radius-lg: 26px; --radius-xl: 34px;
    --trans-fast: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    --trans: 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    --trans-bounce: 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  [data-theme="dark"] {
    --bg: #0d0810; --bg2: #160c1a; --bg3: #1f0f25;
    --card: #1c1120; --card2: #251530;
    --text: #f5e6d3; --text-soft: #b8a5b0;
    --primary: #ff6b9d; --primary-dark: #e94b6f; --primary-light: #ffb3d1;
    --accent: #ffd700; --accent-dark: #d4a373;
    --border: #3a2530; --border-soft: #2a1a20;
    --shadow-sm: 0 4px 15px rgba(0,0,0,0.3);
    --shadow: 0 12px 40px rgba(0,0,0,0.5);
    --shadow-lg: 0 25px 70px rgba(0,0,0,0.7);
    --glow: 0 0 50px rgba(255,107,157,0.5);
    --gradient: linear-gradient(135deg, #0d0810 0%, #160c1a 50%, #2a0f25 100%);
    --gradient-primary: linear-gradient(135deg, #ff6b9d, #e94b6f);
  }

  [data-theme="ocean"] {
    --bg: #eff8ff; --bg2: #d6ebf5; --bg3: #b3d9f0;
    --card: #ffffff; --card2: #f0f9ff;
    --text: #0f2a3a; --text-soft: #4a6b7a;
    --primary: #3b82c4; --primary-dark: #1e5a99; --primary-light: #7ab8e8;
    --accent: #f4a261; --accent-dark: #d97706;
    --border: #b3d9f0; --border-soft: #d6ebf5;
    --shadow: 0 12px 40px rgba(26,58,74,0.10);
    --shadow-lg: 0 25px 70px rgba(26,58,74,0.18);
    --glow: 0 0 40px rgba(59,130,196,0.35);
    --gradient: linear-gradient(135deg, #eff8ff, #d6ebf5, #b3d9f0);
    --gradient-primary: linear-gradient(135deg, #3b82c4, #1e5a99);
  }

  [data-theme="forest"] {
    --bg: #f3faf3; --bg2: #dff0df; --bg3: #c0e0c0;
    --card: #ffffff; --card2: #f3faf3;
    --text: #1a3a1a; --text-soft: #4a6b4a;
    --primary: #2d8b4a; --primary-dark: #1a5a30; --primary-light: #6bc080;
    --accent: #d4a373; --accent-dark: #b8860b;
    --border: #c0e0c0; --border-soft: #dff0df;
    --shadow: 0 12px 40px rgba(30,58,30,0.10);
    --shadow-lg: 0 25px 70px rgba(30,58,30,0.18);
    --glow: 0 0 40px rgba(45,139,74,0.35);
    --gradient: linear-gradient(135deg, #f3faf3, #dff0df, #c0e0c0);
    --gradient-primary: linear-gradient(135deg, #2d8b4a, #1a5a30);
  }

  [data-theme="sunset"] {
    --bg: #fff5eb; --bg2: #ffe4c8; --bg3: #ffd0a0;
    --card: #ffffff; --card2: #fff8f0;
    --text: #4a2210; --text-soft: #7a4a2a;
    --primary: #f97316; --primary-dark: #c2410c; --primary-light: #ffa95e;
    --accent: #e94b6f; --accent-dark: #b8234a;
    --border: #ffd4a8; --border-soft: #ffe4c8;
    --shadow: 0 12px 40px rgba(74,42,26,0.10);
    --shadow-lg: 0 25px 70px rgba(74,42,26,0.18);
    --glow: 0 0 40px rgba(249,115,22,0.35);
    --gradient: linear-gradient(135deg, #fff5eb, #ffe4c8, #ffd0a0);
    --gradient-primary: linear-gradient(135deg, #f97316, #c2410c);
  }

  [data-theme="lavender"] {
    --bg: #f8f5ff; --bg2: #ece3f8; --bg3: #d8c8f0;
    --card: #ffffff; --card2: #faf7ff;
    --text: #2a1a3a; --text-soft: #6a5a7a;
    --primary: #9b6cd4; --primary-dark: #7040b0; --primary-light: #c2a0e8;
    --accent: #e94b6f; --accent-dark: #b8234a;
    --border: #d8c8f0; --border-soft: #ece3f8;
    --shadow: 0 12px 40px rgba(58,42,74,0.10);
    --shadow-lg: 0 25px 70px rgba(58,42,74,0.18);
    --glow: 0 0 40px rgba(155,108,212,0.4);
    --gradient: linear-gradient(135deg, #f8f5ff, #ece3f8, #d8c8f0);
    --gradient-primary: linear-gradient(135deg, #9b6cd4, #7040b0);
  }

  [data-theme="black-gold"] {
    --bg: #050505; --bg2: #0f0f0f; --bg3: #1a1a1a;
    --card: #131313; --card2: #1c1c1c;
    --text: #f0e6d0; --text-soft: #a09070;
    --primary: #d4a373; --primary-dark: #b8860b; --primary-light: #f0c890;
    --accent: #ffd700; --accent-dark: #d4a373;
    --border: #3a3020; --border-soft: #2a2010;
    --shadow-sm: 0 4px 15px rgba(0,0,0,0.5);
    --shadow: 0 12px 40px rgba(0,0,0,0.7);
    --shadow-lg: 0 25px 70px rgba(0,0,0,0.9);
    --glow: 0 0 50px rgba(212,163,115,0.5);
    --gradient: linear-gradient(135deg, #050505, #0f0f0f, #1a1a1a);
    --gradient-primary: linear-gradient(135deg, #d4a373, #b8860b);
  }

  [data-theme="pink-dream"] {
    --bg: #fff0f7; --bg2: #ffd9eb; --bg3: #ffc0e0;
    --card: #ffffff; --card2: #fff5fa;
    --text: #4a1a3a; --text-soft: #7a4a6a;
    --primary: #ff4fa3; --primary-dark: #cc1670; --primary-light: #ff8ac2;
    --accent: #b06cd4; --accent-dark: #8b40b0;
    --border: #ffc0e0; --border-soft: #ffd9eb;
    --shadow: 0 12px 40px rgba(74,26,58,0.10);
    --shadow-lg: 0 25px 70px rgba(74,26,58,0.20);
    --glow: 0 0 40px rgba(255,79,163,0.4);
    --gradient: linear-gradient(135deg, #fff0f7, #ffd9eb, #ffc0e0);
    --gradient-primary: linear-gradient(135deg, #ff4fa3, #cc1670);
  }

  /* ==================== BASE ==================== */
  html { scroll-behavior: smooth; }
  body {
    font-family: 'Vazirmatn', sans-serif;
    background: var(--bg); color: var(--text);
    overflow-x: hidden; line-height: 1.8;
    transition: background 0.5s ease, color 0.5s ease;
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
  }
  body.no-scroll { overflow: hidden; }

  /* ==================== BACKGROUND ANIMATIONS ==================== */
  .bg-hearts {
    position: fixed; inset: 0;
    pointer-events: none; z-index: 0;
    overflow: hidden;
  }
  .bg-heart {
    position: absolute;
    color: var(--primary);
    opacity: 0;
    animation: floatUp linear infinite;
    will-change: transform, opacity;
    filter: blur(0.4px);
  }
  @keyframes floatUp {
    0% { transform: translateY(110vh) rotate(0deg) scale(0.6); opacity: 0; }
    10% { opacity: 0.15; }
    20% { transform: translateY(80vh) rotate(72deg) scale(0.8); }
    50% { transform: translateY(50vh) rotate(180deg) scale(1); opacity: 0.18; }
    80% { transform: translateY(20vh) rotate(288deg) scale(0.9); opacity: 0.12; }
    90% { opacity: 0.08; }
    100% { transform: translateY(-10vh) rotate(360deg) scale(0.6); opacity: 0; }
  }

  /* ==================== SPLASH ==================== */
  #splash {
    position: fixed; inset: 0; z-index: 9999;
    background: var(--gradient);
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    padding: 30px 20px; text-align: center;
    transition: opacity 0.7s ease, visibility 0.7s ease;
  }
  #splash.hide { opacity: 0; visibility: hidden; pointer-events: none; }

  .splash-inner {
    animation: splashIn 0.9s cubic-bezier(0.34, 1.56, 0.64, 1);
    max-width: 520px; width: 100%;
  }
  @keyframes splashIn {
    0% { opacity: 0; transform: scale(0.85) translateY(30px); }
    100% { opacity: 1; transform: scale(1) translateY(0); }
  }

  .splash-heart {
    width: 90px; height: 90px;
    background: var(--gradient-primary);
    position: relative; transform: rotate(-45deg);
    margin: 0 auto 55px;
    animation: heartbeat 1.4s infinite;
    box-shadow: var(--glow), 0 0 80px rgba(233,75,111,0.5);
    border-radius: 4px;
  }
  .splash-heart::before, .splash-heart::after {
    content: ''; width: 90px; height: 90px;
    background: var(--gradient-primary);
    border-radius: 50%; position: absolute;
  }
  .splash-heart::before { top: -45px; left: 0; }
  .splash-heart::after { top: 0; left: 45px; }

  @keyframes heartbeat {
    0%, 100% { transform: rotate(-45deg) scale(1); }
    15% { transform: rotate(-45deg) scale(1.18); }
    30% { transform: rotate(-45deg) scale(1); }
    45% { transform: rotate(-45deg) scale(1.12); }
    60% { transform: rotate(-45deg) scale(1); }
  }

  .splash h1 {
    font-size: clamp(1.6rem, 4.5vw, 2.5rem);
    color: var(--primary-dark); margin-bottom: 12px;
    font-weight: 900; letter-spacing: -0.5px;
    animation: fadeInUp 0.8s 0.3s both;
  }
  .splash .q-sub {
    color: var(--text-soft); font-size: 1.05rem;
    margin-bottom: 42px; font-weight: 500;
    animation: fadeInUp 0.8s 0.5s both;
  }
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .splash-buttons {
    display: flex; gap: 16px; flex-wrap: wrap;
    justify-content: center;
    animation: fadeInUp 0.8s 0.7s both;
  }
  .splash-btn {
    padding: 20px 42px; border-radius: var(--radius);
    border: 3px solid var(--primary);
    background: var(--card); color: var(--primary);
    font-family: inherit; font-size: 1.1rem;
    font-weight: 900; cursor: pointer;
    transition: all var(--trans-bounce);
    min-width: 180px;
    box-shadow: var(--shadow);
    position: relative; overflow: hidden;
  }
  .splash-btn::before {
    content: ''; position: absolute;
    inset: 0; background: var(--gradient-primary);
    transform: translateY(101%); transition: transform var(--trans);
    z-index: -1;
  }
  .splash-btn:hover {
    color: white; border-color: transparent;
    transform: translateY(-6px) scale(1.04);
    box-shadow: var(--shadow-lg), var(--glow);
  }
  .splash-btn:hover::before { transform: translateY(0); }
  .splash-btn.single { border-color: var(--accent); color: var(--accent-dark); }
  .splash-btn.single::before { background: var(--gradient-accent); }
  .splash-btn.single:hover { color: white; border-color: transparent; }

  /* ==================== TOPBAR ==================== */
  .topbar {
    position: sticky; top: 0; z-index: 100;
    background: color-mix(in srgb, var(--card) 92%, transparent);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border-soft);
    padding: 12px 22px;
    display: flex; align-items: center;
    justify-content: space-between;
    box-shadow: var(--shadow-sm);
    transition: all var(--trans);
  }
  .logo {
    font-size: 1.25rem; font-weight: 900;
    color: var(--primary);
    display: flex; align-items: center; gap: 10px;
    cursor: pointer; transition: all var(--trans-fast);
  }
  .logo:hover { transform: scale(1.03); }
  .logo-heart {
    display: inline-block; width: 18px; height: 18px;
    background: var(--gradient-primary);
    transform: rotate(-45deg); position: relative;
    animation: logoHeartBeat 2s infinite;
  }
  @keyframes logoHeartBeat {
    0%, 100% { transform: rotate(-45deg) scale(1); }
    50% { transform: rotate(-45deg) scale(1.15); }
  }
  .logo-heart::before, .logo-heart::after {
    content: ''; width: 18px; height: 18px;
    background: var(--gradient-primary);
    border-radius: 50%; position: absolute;
  }
  .logo-heart::before { top: -9px; left: 0; }
  .logo-heart::after { top: 0; left: 9px; }

  .topbar-right { display: flex; align-items: center; gap: 10px; }
  .user-badge {
    display: flex; align-items: center; gap: 9px;
    background: var(--bg2); padding: 6px 14px 6px 6px;
    border-radius: 50px;
    border: 2px solid var(--border);
    color: var(--text); font-weight: 700;
    font-size: 0.85rem; cursor: pointer;
    transition: all var(--trans);
  }
  .user-badge:hover {
    border-color: var(--primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }
  .user-avatar {
    width: 30px; height: 30px; border-radius: 50%;
    background: var(--gradient-primary);
    color: white;
    display: flex; align-items: center;
    justify-content: center;
    font-weight: 900; font-size: 0.85rem;
    box-shadow: 0 0 15px rgba(233,75,111,0.4);
  }

  .btn-icon {
    width: 40px; height: 40px; border-radius: 50%;
    border: 2px solid var(--border);
    background: var(--card); color: var(--primary);
    cursor: pointer; font-size: 1.05rem;
    display: flex; align-items: center;
    justify-content: center;
    transition: all var(--trans-bounce);
    font-family: inherit; font-weight: 700;
    position: relative; overflow: hidden;
  }
  .btn-icon:hover {
    background: var(--primary); color: white;
    border-color: var(--primary);
    transform: scale(1.12) rotate(8deg);
    box-shadow: var(--glow);
  }
  .btn-icon:active { transform: scale(0.95); }

  /* ==================== NAV MENU ==================== */
  .nav-menu {
    position: fixed; top: 0; right: -360px;
    width: 340px; height: 100vh;
    background: var(--card); z-index: 200;
    padding: 90px 25px 30px;
    box-shadow: -20px 0 60px var(--shadow-lg);
    transition: right 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    border-left: 2px solid var(--border);
    overflow-y: auto;
  }
  .nav-menu.open { right: 0; }
  .nav-menu h3 {
    color: var(--primary); margin-bottom: 20px;
    font-size: 1.15rem; font-weight: 900;
    padding-bottom: 15px;
    border-bottom: 2px solid var(--border-soft);
  }
  .nav-link {
    display: flex; align-items: center; gap: 13px;
    padding: 13px 15px; color: var(--text);
    text-decoration: none; border-radius: var(--radius-sm);
    margin-bottom: 6px; transition: all var(--trans);
    font-weight: 500; cursor: pointer;
    border: none; background: none;
    width: 100%; text-align: right;
    font-family: inherit; font-size: 0.96rem;
    position: relative; overflow: hidden;
  }
  .nav-link::before {
    content: ''; position: absolute;
    right: 0; top: 0; width: 3px; height: 100%;
    background: var(--primary);
    transform: scaleY(0);
    transition: transform var(--trans);
  }
  .nav-link:hover {
    background: var(--bg2); color: var(--primary);
    transform: translateX(-6px);
  }
  .nav-link:hover::before { transform: scaleY(1); }
  .nav-link .ic {
    color: var(--primary);
    font-weight: 900; width: 22px;
    display: flex; align-items: center;
    justify-content: center; font-size: 1.1rem;
  }

  .overlay {
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.55);
    backdrop-filter: blur(4px);
    z-index: 150;
    opacity: 0; pointer-events: none;
    transition: opacity 0.4s ease;
  }
  .overlay.open { opacity: 1; pointer-events: auto; }

  /* ==================== HEADER ==================== */
  header {
    min-height: 82vh;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    text-align: center; padding: 60px 20px;
    background: var(--gradient);
    position: relative; overflow: hidden;
  }
  header::before, header::after {
    content: ''; position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }
  header::before {
    top: -40%; right: -15%;
    width: 650px; height: 650px;
    background: radial-gradient(circle, var(--primary), transparent 65%);
    opacity: 0.18;
    animation: floatSlow 12s infinite ease-in-out;
  }
  header::after {
    bottom: -30%; left: -12%;
    width: 550px; height: 550px;
    background: radial-gradient(circle, var(--accent), transparent 65%);
    opacity: 0.15;
    animation: floatSlow 15s infinite ease-in-out reverse;
  }
  @keyframes floatSlow {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(-30px, 30px) scale(1.08); }
    66% { transform: translate(30px, -20px) scale(0.95); }
  }

  .header-content {
    position: relative; z-index: 2;
    animation: headerIn 1s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes headerIn {
    from { opacity: 0; transform: translateY(40px) scale(0.95); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .main-heart {
    width: 85px; height: 85px;
    background: var(--gradient-primary);
    position: relative; transform: rotate(-45deg);
    margin: 0 auto 45px;
    animation: heartbeat 1.4s infinite;
    box-shadow: var(--glow), 0 0 90px rgba(233,75,111,0.6);
    border-radius: 4px;
  }
  .main-heart::before, .main-heart::after {
    content: ''; width: 85px; height: 85px;
    background: var(--gradient-primary);
    border-radius: 50%; position: absolute;
  }
  .main-heart::before { top: -42.5px; left: 0; }
  .main-heart::after { top: 0; left: 42.5px; }

  header h1 {
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 900; color: var(--primary-dark);
    margin-bottom: 15px; letter-spacing: -1.5px;
    animation: fadeInUp 0.9s 0.3s both;
  }
  header .sub {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: clamp(0.95rem, 2vw, 1.25rem);
    color: var(--text-soft);
    margin-bottom: 32px;
    animation: fadeInUp 0.9s 0.5s both;
  }

  .btn-main {
    display: inline-block; padding: 15px 44px;
    background: var(--gradient-primary);
    color: white; border: none;
    border-radius: 50px;
    font-family: inherit; font-size: 1.05rem;
    font-weight: 700; cursor: pointer;
    text-decoration: none;
    transition: all var(--trans-bounce);
    box-shadow: 0 12px 35px rgba(233,75,111,0.35);
    position: relative; overflow: hidden;
    animation: fadeInUp 0.9s 0.7s both;
  }
  .btn-main::before {
    content: ''; position: absolute;
    top: 0; left: -100%; width: 100%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
    transition: left 0.6s ease;
  }
  .btn-main:hover {
    transform: translateY(-4px) scale(1.04);
    box-shadow: 0 20px 50px rgba(233,75,111,0.5), var(--glow);
  }
  .btn-main:hover::before { left: 100%; }

  /* ==================== SECTIONS ==================== */
  section {
    padding: 75px 22px;
    max-width: 1150px;
    margin: 0 auto;
    position: relative; z-index: 1;
    scroll-margin-top: 80px;
  }
  .section-title {
    font-size: clamp(1.6rem, 3.8vw, 2.3rem);
    font-weight: 900; color: var(--primary-dark);
    text-align: center; margin-bottom: 12px;
    letter-spacing: -0.5px;
    position: relative; display: block;
  }
  .section-title::after {
    content: ''; display: block;
    width: 60px; height: 4px;
    background: var(--gradient-primary);
    border-radius: 4px;
    margin: 15px auto 0;
    animation: expandLine 0.8s ease;
  }
  @keyframes expandLine {
    from { width: 0; }
    to { width: 60px; }
  }
  .section-sub {
    text-align: center; color: var(--text-soft);
    margin-bottom: 45px; font-size: 0.98rem;
  }

  /* ==================== MOOD ==================== */
  .mood-card {
    background: var(--card); border-radius: var(--radius-lg);
    padding: 50px 35px; text-align: center;
    box-shadow: var(--shadow);
    border: 2px solid var(--border-soft);
    max-width: 720px; margin: 0 auto;
    position: relative; overflow: hidden;
    transition: all var(--trans);
  }
  .mood-card::before {
    content: ''; position: absolute;
    top: -120px; left: -120px;
    width: 340px; height: 340px;
    background: radial-gradient(circle, var(--primary), transparent 70%);
    opacity: 0.1; border-radius: 50%;
    animation: floatSlow 10s infinite;
  }
  .mood-title {
    font-size: 1.35rem; font-weight: 900;
    color: var(--primary-dark); margin-bottom: 10px;
    position: relative;
  }
  .mood-desc {
    color: var(--text-soft); margin-bottom: 30px;
    position: relative;
  }

  .mood-options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 12px; margin-bottom: 25px;
    position: relative;
  }
  .mood-opt {
    padding: 18px 14px;
    border-radius: var(--radius);
    border: 2px solid var(--border);
    background: var(--bg2); cursor: pointer;
    font-family: inherit; font-size: 0.92rem;
    font-weight: 700; color: var(--text);
    transition: all var(--trans-bounce);
    position: relative; overflow: hidden;
  }
  .mood-opt::before {
    content: ''; position: absolute;
    inset: 0; background: var(--gradient-primary);
    transform: scale(0); border-radius: 50%;
    transition: transform 0.5s ease;
    z-index: -1;
  }
  .mood-opt:hover {
    border-color: var(--primary);
    transform: translateY(-4px) scale(1.03);
    box-shadow: var(--shadow-sm);
  }
  .mood-opt.selected {
    background: var(--gradient-primary);
    color: white; border-color: transparent;
    box-shadow: var(--glow);
    transform: scale(1.05);
  }
  .mood-opt.selected::before { transform: scale(2); }

  .mood-result {
    background: linear-gradient(135deg, var(--bg2), var(--card));
    border-radius: var(--radius);
    padding: 30px 26px;
    border: 2px dashed var(--primary);
    margin-top: 25px;
    display: none;
    position: relative;
  }
  .mood-result.show {
    display: block;
    animation: resultIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes resultIn {
    from { opacity: 0; transform: scale(0.9) translateY(15px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }
  .mood-result .mr-title {
    font-size: 1.1rem; font-weight: 900;
    color: var(--primary-dark); margin-bottom: 12px;
  }
  .mood-result .mr-text {
    font-size: 1.05rem; color: var(--text);
    line-height: 2; margin-bottom: 15px;
  }
  .mood-result .mr-tip {
    font-size: 0.9rem; color: var(--text-soft);
    padding-top: 15px; border-top: 1px dashed var(--border);
  }

  /* ==================== SINGLES ==================== */
  .singles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 22px;
  }
  .single-card {
    background: var(--card); border-radius: var(--radius-lg);
    padding: 26px 22px;
    box-shadow: var(--shadow-sm);
    border: 2px solid var(--border-soft);
    transition: all var(--trans-bounce);
    position: relative; overflow: hidden;
    animation: cardIn 0.6s ease backwards;
  }
  .single-card:nth-child(1) { animation-delay: 0.05s; }
  .single-card:nth-child(2) { animation-delay: 0.1s; }
  .single-card:nth-child(3) { animation-delay: 0.15s; }
  .single-card:nth-child(4) { animation-delay: 0.2s; }
  .single-card:nth-child(5) { animation-delay: 0.25s; }
  .single-card:nth-child(6) { animation-delay: 0.3s; }
  @keyframes cardIn {
    from { opacity: 0; transform: translateY(25px) scale(0.95); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  .single-card::before {
    content: ''; position: absolute;
    top: 0; left: 0; right: 0; height: 4px;
    background: var(--gradient-primary);
    transform: scaleX(0); transform-origin: right;
    transition: transform var(--trans);
  }
  .single-card:hover {
    transform: translateY(-8px) scale(1.02);
    border-color: var(--primary);
    box-shadow: var(--shadow-lg), 0 0 0 4px var(--border-soft);
  }
  .single-card:hover::before { transform: scaleX(1); }

  .single-card .avatar {
    width: 92px; height: 92px; border-radius: 50%;
    background: var(--gradient-primary);
    margin: 0 auto 16px;
    display: flex; align-items: center;
    justify-content: center; overflow: hidden;
    border: 3px solid var(--card);
    box-shadow: 0 0 0 3px var(--primary), 0 8px 25px rgba(233,75,111,0.25);
    color: white; font-size: 2rem; font-weight: 900;
    transition: all var(--trans-bounce);
  }
  .single-card:hover .avatar {
    transform: scale(1.08) rotate(-5deg);
    box-shadow: 0 0 0 3px var(--primary), 0 12px 40px rgba(233,75,111,0.5);
  }
  .single-card .avatar img {
    width: 100%; height: 100%; object-fit: cover;
  }
  .single-card .name {
    text-align: center; font-size: 1.15rem;
    font-weight: 900; color: var(--primary-dark);
    margin-bottom: 8px;
  }
  .single-card .meta-row {
    display: flex; justify-content: center;
    gap: 7px; margin-bottom: 15px; flex-wrap: wrap;
  }
  .badge {
    padding: 4px 12px; border-radius: 50px;
    font-size: 0.75rem; font-weight: 700;
    background: var(--bg2); color: var(--primary-dark);
    border: 1px solid var(--border);
    transition: all var(--trans-fast);
  }
  .badge.male { background: #dbeafe; color: #1e5a99; border-color: #b3d9f0; }
  .badge.female { background: #fce7f3; color: #b8234a; border-color: #ffd1dc; }
  [data-theme="dark"] .badge.male { background: #1e3a5f; color: #93c5fd; border-color: #3b82c4; }
  [data-theme="dark"] .badge.female { background: #4a1a3a; color: #ffb3d1; border-color: #e94b6f; }

  .single-card .info-line {
    display: flex; align-items: center;
    gap: 8px; font-size: 0.86rem;
    color: var(--text-soft); padding: 7px 0;
    border-bottom: 1px dashed var(--border-soft);
  }
  .single-card .info-line:last-of-type { border-bottom: none; }
  .single-card .info-line .lbl {
    font-weight: 700; color: var(--text);
    min-width: 48px; font-size: 0.83rem;
  }
  .single-card .info-line .val {
    flex: 1; word-break: break-word;
  }

  .single-card .bio {
    margin-top: 12px; padding-top: 12px;
    border-top: 1px dashed var(--border);
    font-size: 0.87rem; color: var(--text-soft);
    line-height: 1.8;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ==================== FORMS ==================== */
  .form-box {
    background: var(--card);
    border-radius: var(--radius-lg);
    padding: 42px 36px;
    box-shadow: var(--shadow);
    border: 2px solid var(--border-soft);
    max-width: 580px; margin: 0 auto;
    position: relative; overflow: hidden;
    animation: formIn 0.6s ease;
  }
  @keyframes formIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .form-box::before {
    content: ''; position: absolute;
    top: 0; left: 0; right: 0; height: 5px;
    background: var(--gradient-primary);
  }
  .form-box h3 {
    color: var(--primary-dark); font-size: 1.4rem;
    margin-bottom: 8px; text-align: center;
    font-weight: 900;
  }
  .form-box .form-sub {
    color: var(--text-soft); font-size: 0.92rem;
    text-align: center; margin-bottom: 28px;
  }
  .form-group { margin-bottom: 16px; }
  .form-group label {
    display: block; margin-bottom: 8px;
    color: var(--text); font-weight: 700;
    font-size: 0.9rem;
  }
  .form-input, .form-select, .form-textarea {
    width: 100%; padding: 14px 16px;
    border-radius: var(--radius-sm);
    border: 2px solid var(--border-soft);
    background: var(--bg); color: var(--text);
    font-family: inherit; font-size: 0.95rem;
    transition: all var(--trans);
  }
  .form-input:focus, .form-select:focus, .form-textarea:focus {
    outline: none; border-color: var(--primary);
    box-shadow: 0 0 0 4px rgba(233,75,111,0.12);
    transform: translateY(-1px);
  }
  .form-textarea {
    resize: vertical; min-height: 95px;
    line-height: 1.8;
  }
  .form-row-2 {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  @media (max-width: 500px) { .form-row-2 { grid-template-columns: 1fr; } }

  .btn-form {
    width: 100%; padding: 15px;
    border-radius: var(--radius);
    border: none; background: var(--gradient-primary);
    color: white; font-family: inherit;
    font-size: 1.02rem; font-weight: 700;
    cursor: pointer; transition: all var(--trans-bounce);
    margin-top: 10px;
    box-shadow: 0 10px 25px rgba(233,75,111,0.3);
    position: relative; overflow: hidden;
  }
  .btn-form::before {
    content: ''; position: absolute;
    top: 0; left: -100%; width: 100%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.25), transparent);
    transition: left 0.6s ease;
  }
  .btn-form:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 15px 40px rgba(233,75,111,0.5), var(--glow);
  }
  .btn-form:hover::before { left: 100%; }
  .btn-form:active { transform: scale(0.98); }

  .btn-form.secondary {
    background: transparent; color: var(--primary);
    border: 2px solid var(--primary);
    box-shadow: none;
  }
  .btn-form.secondary:hover {
    background: var(--primary); color: white;
  }

  .form-switch {
    text-align: center; margin-top: 18px;
    font-size: 0.9rem; color: var(--text-soft);
  }
  .form-switch a {
    color: var(--primary); font-weight: 700;
    cursor: pointer; text-decoration: underline;
    transition: all var(--trans-fast);
  }
  .form-switch a:hover { color: var(--primary-dark); }

  .form-error {
    color: #ef4444; font-size: 0.85rem;
    text-align: center; margin-top: 10px;
    min-height: 18px; font-weight: 700;
  }
  .form-success {
    color: #10b981; font-size: 0.85rem;
    text-align: center; margin-top: 10px;
    min-height: 18px; font-weight: 700;
  }

  /* ==================== TABS ==================== */
  .tabs {
    display: flex; gap: 8px;
    justify-content: center; flex-wrap: wrap;
    margin-bottom: 32px;
    padding: 6px; border-radius: 50px;
    background: var(--bg2);
    max-width: fit-content; margin-left: auto; margin-right: auto;
    border: 2px solid var(--border-soft);
  }
  .tab {
    padding: 11px 22px; border-radius: 50px;
    border: none; background: transparent;
    color: var(--text); cursor: pointer;
    font-family: inherit; font-size: 0.9rem;
    font-weight: 700; transition: all var(--trans);
    position: relative;
  }
  .tab.active {
    background: var(--gradient-primary);
    color: white;
    box-shadow: 0 6px 20px rgba(233,75,111,0.35);
    transform: scale(1.03);
  }
  .tab:not(.active):hover {
    background: var(--card);
    color: var(--primary);
  }

  .tab-panel { display: none; }
  .tab-panel.active {
    display: block;
    animation: tabIn 0.5s ease;
  }
  @keyframes tabIn {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ==================== GAMES ==================== */
  .game-panel {
    display: none; background: var(--card);
    border-radius: var(--radius-lg);
    padding: 42px 32px;
    box-shadow: var(--shadow);
    border: 2px solid var(--border-soft);
    text-align: center;
    position: relative; overflow: hidden;
  }
  .game-panel::before {
    content: ''; position: absolute;
    top: -100px; right: -100px;
    width: 300px; height: 300px;
    background: radial-gradient(circle, var(--primary), transparent 70%);
    opacity: 0.08; border-radius: 50%;
  }
  .game-panel.active {
    display: block;
    animation: tabIn 0.5s ease;
  }
  .game-panel h3 {
    font-size: 1.35rem; color: var(--primary-dark);
    margin-bottom: 8px; font-weight: 900;
    position: relative;
  }
  .game-panel .game-hint {
    color: var(--text-soft); margin-bottom: 26px;
    font-size: 0.92rem; position: relative;
  }

  /* RPS */
  .rps-choices {
    display: flex; justify-content: center;
    gap: 14px; flex-wrap: wrap;
    margin-bottom: 25px;
  }
  .rps-btn {
    width: 100px; height: 100px;
    border-radius: var(--radius);
    border: 2px solid var(--border);
    background: var(--bg2); cursor: pointer;
    font-size: 2.2rem;
    transition: all var(--trans-bounce);
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 4px; font-family: inherit;
    color: var(--text); position: relative;
    overflow: hidden;
  }
  .rps-btn::before {
    content: ''; position: absolute;
    inset: 0; background: var(--gradient-primary);
    transform: translateY(100%);
    transition: transform var(--trans);
    z-index: 0;
  }
  .rps-btn > * { position: relative; z-index: 1; }
  .rps-btn:hover {
    transform: translateY(-6px) scale(1.05);
    border-color: transparent;
    color: white;
    box-shadow: var(--glow);
  }
  .rps-btn:hover::before { transform: translateY(0); }
  .rps-btn span.lbl { font-size: 0.72rem; font-weight: 700; }

  .rps-result {
    background: var(--bg2);
    border-radius: var(--radius);
    padding: 24px; margin-top: 18px;
    min-height: 100px;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 8px;
    border: 2px solid var(--border-soft);
  }
  .rps-battle {
    font-size: 1rem; color: var(--text-soft);
  }
  .rps-outcome {
    font-size: 1.4rem; font-weight: 900;
    color: var(--primary-dark);
    animation: popIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes popIn {
    from { opacity: 0; transform: scale(0.5); }
    to { opacity: 1; transform: scale(1); }
  }

  .score-row {
    display: flex; justify-content: center;
    gap: 14px; margin-top: 18px; flex-wrap: wrap;
  }
  .score-box {
    background: var(--bg2); padding: 16px 28px;
    border-radius: var(--radius); min-width: 95px;
    border: 2px solid var(--border-soft);
    transition: all var(--trans-bounce);
  }
  .score-box:hover { transform: translateY(-3px); }
  .score-box .n {
    font-size: 1.7rem; font-weight: 900;
    color: var(--primary); line-height: 1;
  }
  .score-box .l {
    font-size: 0.8rem; color: var(--text-soft);
    margin-top: 4px;
  }

  /* Guess */
  .guess-input {
    display: flex; gap: 10px;
    justify-content: center;
    max-width: 380px; margin: 0 auto 18px;
  }
  .guess-input input {
    flex: 1; padding: 14px 18px;
    border-radius: var(--radius);
    border: 2px solid var(--border-soft);
    background: var(--bg); color: var(--text);
    font-family: inherit; font-size: 1.05rem;
    text-align: center; font-weight: 700;
    transition: all var(--trans);
  }
  .guess-input input:focus {
    outline: none; border-color: var(--primary);
    box-shadow: 0 0 0 4px rgba(233,75,111,0.12);
  }
  .guess-input button {
    padding: 14px 28px;
    border-radius: var(--radius);
    border: none; background: var(--gradient-primary);
    color: white; font-family: inherit;
    font-weight: 700; cursor: pointer;
    font-size: 0.95rem;
    transition: all var(--trans-bounce);
  }
  .guess-input button:hover {
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 10px 25px rgba(233,75,111,0.4);
  }

  .guess-feedback {
    font-size: 1.15rem; font-weight: 700;
    color: var(--primary-dark);
    min-height: 28px; margin-bottom: 18px;
    animation: popIn 0.4s ease;
  }
  .guess-history {
    display: flex; flex-wrap: wrap;
    gap: 8px; justify-content: center;
    margin-top: 18px;
  }
  .guess-chip {
    padding: 7px 15px; border-radius: var(--radius-sm);
    background: var(--bg2); font-weight: 700;
    font-size: 0.88rem; color: var(--text);
    border: 2px solid var(--border-soft);
    animation: popIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    transition: all var(--trans-fast);
  }
  .guess-chip.high { border-color: #f59e0b; color: #f59e0b; background: #fef3c7; }
  .guess-chip.low { border-color: #3b82f6; color: #3b82f6; background: #dbeafe; }
  .guess-chip.win {
    border-color: var(--primary);
    background: var(--gradient-primary);
    color: white;
    animation: winPulse 1s infinite;
  }
  @keyframes winPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.08); }
  }

  /* Memory */
  .memory-grid {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 10px; max-width: 500px;
    margin: 0 auto 18px;
  }
  .memory-card {
    aspect-ratio: 1; border-radius: var(--radius);
    background: var(--gradient-primary);
    cursor: pointer;
    display: flex; align-items: center;
    justify-content: center; font-size: 1.9rem;
    color: white;
    transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    border: 2px solid var(--card);
    user-select: none;
    transform-style: preserve-3d;
    position: relative;
    box-shadow: 0 6px 20px rgba(233,75,111,0.25);
  }
  .memory-card:hover:not(.flipped):not(.matched) {
    transform: translateY(-4px) scale(1.03);
    box-shadow: 0 12px 30px rgba(233,75,111,0.4);
  }
  .memory-card.flipped {
    background: var(--bg2);
    color: var(--primary-dark);
    transform: rotateY(180deg);
    box-shadow: 0 8px 25px rgba(0,0,0,0.1);
  }
  .memory-card.matched {
    background: linear-gradient(135deg, #10b981, #059669);
    color: white;
    cursor: default;
    transform: rotateY(180deg) scale(1.05);
    box-shadow: 0 0 30px rgba(16,185,129,0.6);
    animation: matchPulse 0.6s ease;
  }
  @keyframes matchPulse {
    0% { transform: rotateY(180deg) scale(1); }
    50% { transform: rotateY(180deg) scale(1.15); }
    100% { transform: rotateY(180deg) scale(1.05); }
  }
  .memory-status {
    font-size: 1.05rem; font-weight: 700;
    color: var(--primary-dark); margin-top: 12px;
  }

  /* TTT */
  .ttt-board {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 10px; max-width: 330px;
    margin: 0 auto 18px;
  }
  .ttt-cell {
    aspect-ratio: 1; background: var(--bg2);
    border-radius: var(--radius);
    border: 2px solid var(--border-soft);
    cursor: pointer; font-size: 2.3rem;
    font-weight: 900; color: var(--primary-dark);
    display: flex; align-items: center;
    justify-content: center;
    transition: all var(--trans-bounce);
    font-family: inherit;
    position: relative; overflow: hidden;
  }
  .ttt-cell:hover:not(.taken) {
    background: var(--bg3);
    transform: scale(1.06);
    border-color: var(--primary);
    box-shadow: 0 0 20px rgba(233,75,111,0.3);
  }
  .ttt-cell.taken { cursor: not-allowed; }
  .ttt-cell.taken:hover { transform: none; }
  .ttt-cell.win {
    background: linear-gradient(135deg, #10b981, #059669);
    color: white;
    animation: winPulse 1s infinite;
    box-shadow: 0 0 30px rgba(16,185,129,0.6);
  }
  .ttt-status {
    font-size: 1.15rem; font-weight: 700;
    color: var(--primary-dark);
    margin-top: 12px; min-height: 28px;
  }

  /* Speed Quiz */
  .speed-timer {
    font-size: 2rem; font-weight: 900;
    color: var(--primary); margin-bottom: 12px;
    transition: all var(--trans-fast);
    display: inline-block;
  }
  .speed-timer.warning {
    color: #ef4444;
    animation: timerPulse 0.5s infinite;
  }
  @keyframes timerPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.2); }
  }
  .speed-quiz-q {
    font-size: 1.2rem; font-weight: 700;
    color: var(--text); margin-bottom: 22px;
    min-height: 55px;
  }
  .speed-quiz-opts {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 10px; max-width: 560px;
    margin: 0 auto;
  }
  @media (max-width: 500px) {
    .speed-quiz-opts { grid-template-columns: 1fr; }
  }
  .speed-opt {
    padding: 15px 18px;
    border-radius: var(--radius);
    border: 2px solid var(--border-soft);
    background: var(--bg2); color: var(--text);
    font-family: inherit; font-weight: 700;
    cursor: pointer; transition: all var(--trans);
    font-size: 0.95rem;
  }
  .speed-opt:hover {
    background: var(--gradient-primary);
    color: white;
    border-color: transparent;
    transform: translateY(-3px);
    box-shadow: var(--shadow-sm);
  }
  .speed-opt.correct {
    background: linear-gradient(135deg, #10b981, #059669);
    color: white; border-color: transparent;
    animation: correctPulse 0.5s ease;
  }
  .speed-opt.wrong {
    background: linear-gradient(135deg, #ef4444, #dc2626);
    color: white; border-color: transparent;
    animation: shake 0.4s ease;
  }
  @keyframes correctPulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.08); }
    100% { transform: scale(1); }
  }
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-6px); }
    75% { transform: translateX(6px); }
  }
  .speed-status {
    font-size: 1.15rem; font-weight: 700;
    color: var(--primary-dark);
    margin-top: 18px; min-height: 28px;
  }

  /* ==================== LOVE QUIZ ==================== */
  .quiz-box {
    background: var(--card);
    border-radius: var(--radius-lg);
    padding: 45px 38px;
    box-shadow: var(--shadow);
    border: 2px solid var(--border-soft);
    position: relative; overflow: hidden;
  }
  .quiz-box::before {
    content: ''; position: absolute;
    top: -100px; left: -100px;
    width: 300px; height: 300px;
    background: radial-gradient(circle, var(--primary), transparent 70%);
    opacity: 0.08; border-radius: 50%;
  }

  .quiz-progress {
    height: 10px; background: var(--bg2);
    border-radius: 10px; overflow: hidden;
    margin-bottom: 32px;
    position: relative;
  }
  .quiz-progress-bar {
    height: 100%; background: var(--gradient-primary);
    width: 0%; transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 10px;
    box-shadow: 0 0 15px rgba(233,75,111,0.5);
    position: relative;
  }
  .quiz-progress-bar::after {
    content: ''; position: absolute;
    top: 0; right: 0;
    width: 30px; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.5));
    animation: progressShine 2s infinite;
  }
  @keyframes progressShine {
    0% { transform: translateX(0); }
    100% { transform: translateX(-300px); }
  }

  .quiz-step { display: none; position: relative; }
  .quiz-step.active {
    display: block;
    animation: quizStepIn 0.5s ease;
  }
  @keyframes quizStepIn {
    from { opacity: 0; transform: translateX(30px); }
    to { opacity: 1; transform: translateX(0); }
  }

  .question-num {
    font-size: 0.85rem; color: var(--primary);
    font-weight: 700; margin-bottom: 10px;
    letter-spacing: 1px;
  }
  .question-text {
    font-size: 1.28rem; font-weight: 700;
    color: var(--text); margin-bottom: 26px;
    line-height: 1.7;
  }
  .options { display: grid; gap: 12px; }
  .option {
    padding: 18px 22px;
    background: var(--bg2);
    border: 2px solid transparent;
    border-radius: var(--radius);
    cursor: pointer;
    transition: all var(--trans-bounce);
    font-size: 0.98rem;
    font-family: inherit;
    text-align: right;
    color: var(--text);
    display: flex; align-items: center;
    gap: 15px;
    position: relative; overflow: hidden;
  }
  .option::before {
    content: ''; position: absolute;
    right: 0; top: 0; width: 4px; height: 100%;
    background: var(--primary);
    transform: scaleY(0);
    transition: transform var(--trans);
  }
  .option:hover {
    border-color: var(--primary);
    background: var(--card);
    transform: translateX(-6px);
    box-shadow: var(--shadow-sm);
  }
  .option:hover::before { transform: scaleY(1); }
  .option.selected {
    background: var(--gradient-primary);
    color: white;
    border-color: transparent;
    box-shadow: 0 10px 30px rgba(233,75,111,0.35);
    transform: translateX(-6px);
    animation: popIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .option-letter {
    width: 34px; height: 34px;
    border-radius: 50%; background: var(--card);
    color: var(--primary-dark);
    display: flex; align-items: center;
    justify-content: center;
    font-weight: 900; flex-shrink: 0;
    transition: all var(--trans-fast);
    border: 2px solid var(--border);
  }
  .option.selected .option-letter {
    background: white; color: var(--primary);
    border-color: white;
    transform: rotate(360deg);
  }

  .quiz-nav {
    display: flex; justify-content: space-between;
    margin-top: 32px; gap: 15px;
    position: relative;
  }
  .btn-quiz {
    padding: 13px 34px;
    border-radius: 50px;
    border: none; font-family: inherit;
    font-size: 0.98rem; font-weight: 700;
    cursor: pointer; transition: all var(--trans-bounce);
  }
  .btn-next {
    background: var(--gradient-primary);
    color: white;
    box-shadow: 0 10px 25px rgba(233,75,111,0.3);
  }
  .btn-next:hover:not(:disabled) {
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 15px 40px rgba(233,75,111,0.5), var(--glow);
  }
  .btn-next:disabled {
    opacity: 0.4; cursor: not-allowed;
    transform: none !important;
  }
  .btn-back {
    background: transparent;
    color: var(--primary);
    border: 2px solid var(--primary);
  }
  .btn-back:hover {
    background: var(--primary); color: white;
    transform: translateY(-3px);
  }

  .quiz-result {
    display: none; text-align: center;
    padding: 30px 20px;
    position: relative;
  }
  .quiz-result.active {
    display: block;
    animation: resultIn 0.7s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .result-score {
    font-size: 5rem; font-weight: 900;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1; margin-bottom: 12px;
    animation: popIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .result-label {
    font-size: 1.35rem; font-weight: 900;
    color: var(--primary-dark);
    margin-bottom: 20px;
  }
  .result-message {
    font-size: 1.02rem; color: var(--text-soft);
    max-width: 500px; margin: 0 auto 30px;
    line-height: 1.9;
  }

  /* ==================== MESSAGE GENERATOR ==================== */
  .generator {
    background: var(--gradient-primary);
    border-radius: var(--radius-lg);
    padding: 55px 40px;
    text-align: center; color: white;
    box-shadow: 0 30px 80px rgba(233,75,111,0.35);
    position: relative; overflow: hidden;
  }
  .generator::before, .generator::after {
    content: ''; position: absolute;
    border-radius: 50%; pointer-events: none;
  }
  .generator::before {
    top: -80px; right: -80px;
    width: 280px; height: 280px;
    background: radial-gradient(circle, rgba(255,255,255,0.2), transparent 70%);
    animation: floatSlow 8s infinite;
  }
  .generator::after {
    bottom: -100px; left: -100px;
    width: 320px; height: 320px;
    background: radial-gradient(circle, rgba(255,255,255,0.15), transparent 70%);
    animation: floatSlow 12s infinite reverse;
  }
  .generator h2 {
    font-size: clamp(1.4rem, 3.5vw, 2.1rem);
    margin-bottom: 12px; font-weight: 900;
    position: relative; z-index: 1;
  }
  .generator .intro {
    opacity: 0.9; margin-bottom: 30px;
    position: relative; z-index: 1;
  }

  .message-display {
    background: rgba(255,255,255,0.18);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1.5px solid rgba(255,255,255,0.3);
    border-radius: var(--radius);
    padding: 38px 28px;
    margin-bottom: 26px;
    min-height: 140px;
    display: flex; align-items: center;
    justify-content: center;
    font-size: 1.15rem; line-height: 2;
    transition: all 0.4s ease;
    position: relative; z-index: 1;
    box-shadow: inset 0 0 40px rgba(255,255,255,0.1);
  }
  .message-display.changing {
    opacity: 0.3;
    transform: scale(0.97) rotate(-0.5deg);
  }

  .btn-generate {
    background: white;
    color: var(--primary-dark);
    padding: 15px 42px;
    border-radius: 50px; border: none;
    font-family: inherit; font-size: 1rem;
    font-weight: 700; cursor: pointer;
    transition: all var(--trans-bounce);
    position: relative; z-index: 1;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
  }
  .btn-generate:hover {
    transform: translateY(-4px) scale(1.04);
    box-shadow: 0 20px 50px rgba(0,0,0,0.25);
  }
  .btn-generate:active { transform: scale(0.97); }

  /* ==================== COUNTER ==================== */
  .counter-box {
    text-align: center;
    background: var(--card);
    border-radius: var(--radius-lg);
    padding: 48px 30px;
    box-shadow: var(--shadow);
    border: 2px dashed var(--border);
    position: relative; overflow: hidden;
  }
  .counter-box h3 {
    font-size: 1.3rem; color: var(--primary-dark);
    margin-bottom: 10px; font-weight: 900;
  }
  .counter-box .hint {
    color: var(--text-soft); margin-bottom: 32px;
    font-size: 0.94rem;
  }
  .love-counter {
    display: flex; justify-content: center;
    gap: 20px; flex-wrap: wrap;
    margin-bottom: 30px;
  }
  .counter-item {
    background: var(--bg2);
    border-radius: var(--radius);
    padding: 24px 20px; min-width: 115px;
    border: 2px solid var(--border-soft);
    transition: all var(--trans-bounce);
  }
  .counter-item:hover {
    transform: translateY(-5px) scale(1.03);
    box-shadow: var(--shadow-sm);
    border-color: var(--primary);
  }
  .counter-num {
    font-size: 2.3rem; font-weight: 900;
    color: var(--primary); line-height: 1;
    transition: all var(--trans-fast);
    display: inline-block;
  }
  .counter-num.pop {
    animation: numberPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes numberPop {
    0% { transform: scale(1); }
    50% { transform: scale(1.4); color: var(--primary-dark); }
    100% { transform: scale(1); }
  }
  .counter-lbl {
    font-size: 0.85rem; color: var(--text-soft);
    margin-top: 8px;
  }
  .btn-heart {
    background: var(--gradient-primary);
    color: white; padding: 16px 40px;
    border-radius: 50px; border: none;
    font-family: inherit; font-size: 1rem;
    font-weight: 700; cursor: pointer;
    transition: all var(--trans-bounce);
    box-shadow: 0 12px 30px rgba(233,75,111,0.35);
  }
  .btn-heart:hover {
    transform: translateY(-4px) scale(1.05);
    box-shadow: 0 20px 45px rgba(233,75,111,0.5), var(--glow);
  }
  .btn-heart:active { transform: scale(0.96); }

  /* ==================== NOTES ==================== */
  .note-area {
    background: var(--card);
    border-radius: var(--radius-lg);
    padding: 38px 32px;
    box-shadow: var(--shadow);
    border: 2px solid var(--border-soft);
  }
  .note-area textarea {
    width: 100%; min-height: 140px;
    padding: 18px; border-radius: var(--radius);
    border: 2px solid var(--border-soft);
    background: var(--bg); color: var(--text);
    font-family: inherit; font-size: 1rem;
    resize: vertical; line-height: 1.9;
    margin-bottom: 15px;
    transition: all var(--trans);
  }
  .note-area textarea:focus {
    outline: none; border-color: var(--primary);
    box-shadow: 0 0 0 4px rgba(233,75,111,0.12);
  }
  .notes-list {
    display: flex; flex-direction: column;
    gap: 12px; margin-top: 25px;
  }
  .note-item {
    background: linear-gradient(135deg, var(--bg2), var(--card));
    padding: 18px 22px;
    border-radius: var(--radius);
    border-right: 4px solid var(--primary);
    display: flex; justify-content: space-between;
    align-items: flex-start; gap: 12px;
    animation: cardIn 0.5s ease;
    transition: all var(--trans);
    box-shadow: var(--shadow-sm);
  }
  .note-item:hover {
    transform: translateX(-5px);
    box-shadow: var(--shadow);
  }
  .note-item .note-txt {
    flex: 1; color: var(--text);
    font-size: 0.98rem; line-height: 1.8;
    word-break: break-word;
  }
  .note-item .note-date {
    font-size: 0.75rem; color: var(--text-soft);
    margin-top: 8px;
  }
  .note-item .del-btn {
    background: #ef4444; color: white;
    border: none; border-radius: var(--radius-sm);
    padding: 7px 14px; cursor: pointer;
    font-family: inherit; font-weight: 700;
    font-size: 0.8rem; flex-shrink: 0;
    transition: all var(--trans-fast);
  }
  .note-item .del-btn:hover {
    background: #b91c1c;
    transform: scale(1.05);
  }

  /* ==================== QUICK QUESTIONS ==================== */
  .quick-questions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 22px;
  }
  .q-card {
    background: var(--card);
    border-radius: var(--radius-lg);
    padding: 30px 24px;
    box-shadow: var(--shadow-sm);
    border: 2px solid var(--border-soft);
    text-align: center;
    transition: all var(--trans-bounce);
    position: relative; overflow: hidden;
  }
  .q-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
    border-color: var(--primary);
  }
  .q-card .q-text {
    font-size: 1.05rem; font-weight: 700;
    color: var(--text); margin-bottom: 18px;
    min-height: 55px;
    display: flex; align-items: center;
    justify-content: center;
  }
  .q-buttons {
    display: flex; gap: 10px;
    justify-content: center;
  }
  .q-btn {
    flex: 1; padding: 12px;
    border-radius: var(--radius-sm);
    border: 2px solid var(--primary);
    background: transparent; color: var(--primary);
    font-family: inherit; font-weight: 700;
    cursor: pointer; transition: all var(--trans);
    font-size: 0.9rem;
  }
  .q-btn:hover {
    background: var(--gradient-primary);
    color: white; border-color: transparent;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(233,75,111,0.3);
  }
  .q-result {
    margin-top: 12px; font-size: 0.88rem;
    color: var(--primary-dark); font-weight: 700;
    min-height: 20px; opacity: 0;
    transition: opacity 0.4s ease;
  }
  .q-result.show { opacity: 1; animation: popIn 0.4s ease; }

  /* ==================== LOVE CARD TIPS ==================== */
  .love-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(255px, 1fr));
    gap: 22px;
  }
  .love-card {
    background: var(--card);
    border-radius: var(--radius-lg);
    padding: 32px 26px;
    box-shadow: var(--shadow-sm);
    border: 2px solid transparent;
    transition: all var(--trans-bounce);
    position: relative; overflow: hidden;
  }
  .love-card::before {
    content: ''; position: absolute;
    top: 0; right: 0; width: 100%; height: 4px;
    background: var(--gradient-primary);
    transform: scaleX(0); transform-origin: right;
    transition: transform var(--trans);
  }
  .love-card:hover::before { transform: scaleX(1); }
  .love-card:hover {
    transform: translateY(-8px);
    border-color: var(--border);
    box-shadow: var(--shadow-lg);
  }
  .card-icon {
    width: 55px; height: 55px;
    border-radius: var(--radius);
    background: var(--gradient-primary);
    display: flex; align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    font-size: 1.5rem; color: white;
    font-weight: 900;
    font-family: 'Playfair Display', serif;
    transition: all var(--trans-bounce);
    box-shadow: 0 8px 20px rgba(233,75,111,0.3);
  }
  .love-card:hover .card-icon {
    transform: rotate(-8deg) scale(1.1);
    box-shadow: 0 12px 35px rgba(233,75,111,0.5);
  }
  .love-card h3 {
    font-size: 1.15rem; color: var(--primary-dark);
    margin-bottom: 10px; font-weight: 900;
  }
  .love-card p {
    color: var(--text-soft); font-size: 0.94rem;
    line-height: 1.9;
  }

  /* ==================== FINAL NOTE ==================== */
  .love-note-final {
    background: linear-gradient(135deg, var(--bg2), var(--card));
    border-radius: var(--radius-xl);
    padding: 60px 40px;
    text-align: center;
    border: 2px solid var(--border-soft);
    position: relative; overflow: hidden;
  }
  .love-note-final::before {
    content: '“'; position: absolute;
    top: 15px; right: 30px;
    font-family: 'Playfair Display', serif;
    font-size: 8rem; color: var(--border);
    line-height: 1; opacity: 0.6;
  }
  .love-note-final p {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: clamp(1.05rem, 2.3vw, 1.4rem);
    color: var(--text); line-height: 2.2;
    max-width: 700px; margin: 0 auto;
    position: relative; z-index: 1;
  }
  .love-note-final .signature {
    margin-top: 28px;
    font-family: 'Vazirmatn', sans-serif;
    font-style: normal;
    font-size: 0.92rem;
    color: var(--primary); font-weight: 700;
    position: relative; z-index: 1;
  }

  /* ==================== FOOTER ==================== */
  footer {
    background: var(--card);
    color: var(--text-soft);
    text-align: center;
    padding: 50px 20px;
    margin-top: 60px;
    border-top: 1px solid var(--border-soft);
    position: relative; z-index: 1;
  }
  footer .foot-heart {
    font-size: 1.9rem; color: var(--primary);
    margin-bottom: 12px; display: inline-block;
    animation: heartbeat 1.4s infinite;
  }
  footer p { font-size: 0.92rem; }

  /* ==================== FAB (+) ==================== */
  .fab-plus {
    position: fixed; bottom: 30px; left: 30px;
    width: 62px; height: 62px; border-radius: 50%;
    background: var(--gradient-primary);
    color: white; border: none;
    font-size: 2rem; font-weight: 300;
    cursor: pointer;
    box-shadow: 0 12px 35px rgba(233,75,111,0.45), var(--glow);
    z-index: 90;
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    display: flex; align-items: center;
    justify-content: center; line-height: 1;
    font-family: inherit;
    will-change: transform;
  }
  .fab-plus::before {
    content: ''; position: absolute;
    inset: -6px; border-radius: 50%;
    border: 2px solid var(--primary);
    opacity: 0; animation: fabRing 2s infinite;
  }
  @keyframes fabRing {
    0% { transform: scale(1); opacity: 0.6; }
    100% { transform: scale(1.4); opacity: 0; }
  }
  .fab-plus:hover {
    transform: scale(1.15) rotate(90deg);
    box-shadow: 0 20px 60px rgba(233,75,111,0.6), 0 0 80px rgba(233,75,111,0.8);
  }
  .fab-plus.open {
    transform: rotate(135deg) scale(1.05);
    background: var(--primary-dark);
  }
  .fab-plus:active { transform: scale(0.92); }

  .fab-menu {
    position: fixed; bottom: 105px; left: 30px;
    z-index: 90; display: flex;
    flex-direction: column; gap: 12px;
    opacity: 0; pointer-events: none;
    transform: translateY(20px) scale(0.9);
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .fab-menu.open {
    opacity: 1; pointer-events: auto;
    transform: translateY(0) scale(1);
  }
  .fab-item {
    display: flex; align-items: center; gap: 12px;
    background: var(--card);
    padding: 13px 20px 13px 15px;
    border-radius: 50px;
    box-shadow: var(--shadow);
    cursor: pointer;
    border: 2px solid var(--border-soft);
    transition: all var(--trans-bounce);
    font-family: inherit; color: var(--text);
    font-weight: 700; font-size: 0.94rem;
    white-space: nowrap;
    animation: fabItemIn 0.4s backwards;
  }
  .fab-menu.open .fab-item:nth-child(1) { animation-delay: 0.05s; }
  .fab-menu.open .fab-item:nth-child(2) { animation-delay: 0.1s; }
  .fab-menu.open .fab-item:nth-child(3) { animation-delay: 0.15s; }
  .fab-menu.open .fab-item:nth-child(4) { animation-delay: 0.2s; }
  .fab-menu.open .fab-item:nth-child(5) { animation-delay: 0.25s; }
  @keyframes fabItemIn {
    from { opacity: 0; transform: translateX(-20px) scale(0.8); }
    to { opacity: 1; transform: translateX(0) scale(1); }
  }
  .fab-item:hover {
    background: var(--gradient-primary);
    color: white; border-color: transparent;
    transform: translateX(8px) scale(1.03);
    box-shadow: 0 12px 35px rgba(233,75,111,0.4);
  }
  .fab-item .ic {
    width: 32px; height: 32px;
    border-radius: 50%;
    background: var(--bg2);
    display: flex; align-items: center;
    justify-content: center; font-size: 0.95rem;
    color: var(--primary); font-weight: 900;
    transition: all var(--trans);
  }
  .fab-item:hover .ic {
    background: rgba(255,255,255,0.25);
    color: white;
    transform: rotate(-15deg);
  }

  /* ==================== ADMIN PANEL ==================== */
  .admin-overlay {
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.75);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    z-index: 500;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    animation: fadeIn 0.3s ease;
  }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  .admin-overlay.open { display: flex; }

  .admin-panel {
    background: var(--card);
    border-radius: var(--radius-lg);
    width: 100%; max-width: 720px;
    max-height: 92vh; overflow-y: auto;
    padding: 45px 38px;
    border: 2px solid var(--primary);
    box-shadow: 0 30px 100px rgba(0,0,0,0.5), 0 0 80px rgba(233,75,111,0.3);
    position: relative;
    animation: panelIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes panelIn {
    from { opacity: 0; transform: scale(0.9) translateY(30px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }
  .admin-panel::-webkit-scrollbar { width: 8px; }
  .admin-panel::-webkit-scrollbar-track { background: var(--bg2); border-radius: 10px; }
  .admin-panel::-webkit-scrollbar-thumb {
    background: var(--gradient-primary);
    border-radius: 10px;
  }

  .admin-close {
    position: absolute; top: 18px; left: 18px;
    width: 38px; height: 38px;
    border-radius: 50%;
    background: var(--bg2); border: none;
    cursor: pointer; font-size: 1.2rem;
    color: var(--primary-dark);
    font-weight: 900; font-family: inherit;
    transition: all var(--trans-bounce);
    display: flex; align-items: center;
    justify-content: center;
  }
  .admin-close:hover {
    background: #ef4444; color: white;
    transform: rotate(90deg) scale(1.1);
  }

  .admin-panel h2 {
    color: var(--primary-dark);
    font-size: 1.55rem; margin-bottom: 8px;
    display: flex; align-items: center;
    gap: 12px; font-weight: 900;
  }
  .admin-badge {
    background: var(--gradient-primary);
    color: white; font-size: 0.68rem;
    padding: 5px 12px; border-radius: 50px;
    font-weight: 700; letter-spacing: 1px;
  }
  .admin-sub {
    color: var(--text-soft); font-size: 0.92rem;
    margin-bottom: 28px;
  }

  .admin-login { text-align: center; padding: 15px 0; }
  .admin-login input {
    width: 100%; max-width: 320px;
    padding: 15px 20px;
    border-radius: var(--radius);
    border: 2px solid var(--border-soft);
    background: var(--bg); color: var(--text);
    font-family: inherit; font-size: 1rem;
    text-align: center; margin-bottom: 15px;
    font-weight: 700; letter-spacing: 3px;
    transition: all var(--trans);
  }
  .admin-login input:focus {
    outline: none; border-color: var(--primary);
    box-shadow: 0 0 0 4px rgba(233,75,111,0.12);
  }
  .admin-error {
    color: #ef4444; font-size: 0.88rem;
    font-weight: 700; margin-top: 10px;
    min-height: 20px;
    animation: shake 0.4s ease;
  }

  .admin-content { display: none; }
  .admin-content.show { display: block; animation: tabIn 0.5s ease; }

  .admin-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 12px; margin-bottom: 30px;
  }
  .admin-stat {
    background: var(--bg2);
    border-radius: var(--radius);
    padding: 20px 15px; text-align: center;
    border: 2px solid var(--border-soft);
    transition: all var(--trans-bounce);
  }
  .admin-stat:hover {
    transform: translateY(-4px);
    border-color: var(--primary);
    box-shadow: var(--shadow-sm);
  }
  .admin-stat .n {
    font-size: 1.8rem; font-weight: 900;
    color: var(--primary); line-height: 1;
  }
  .admin-stat .l {
    font-size: 0.78rem; color: var(--text-soft);
    margin-top: 6px;
  }

  .admin-section {
    margin-bottom: 26px;
    padding-bottom: 26px;
    border-bottom: 1px dashed var(--border-soft);
  }
  .admin-section:last-child {
    border-bottom: none; padding-bottom: 0;
  }
  .admin-section h3 {
    color: var(--primary-dark);
    font-size: 1.08rem; margin-bottom: 15px;
    font-weight: 900;
    display: flex; align-items: center;
    gap: 8px;
  }

  .admin-input {
    width: 100%; padding: 13px 16px;
    border-radius: var(--radius-sm);
    border: 2px solid var(--border-soft);
    background: var(--bg); color: var(--text);
    font-family: inherit; font-size: 0.94rem;
    margin-bottom: 10px;
    transition: all var(--trans);
  }
  .admin-input:focus {
    outline: none; border-color: var(--primary);
    box-shadow: 0 0 0 4px rgba(233,75,111,0.12);
  }
  textarea.admin-input {
    resize: vertical; min-height: 70px;
    line-height: 1.8;
  }

  .admin-btn {
    padding: 12px 26px;
    border-radius: var(--radius-sm);
    border: none; background: var(--gradient-primary);
    color: white; font-family: inherit;
    font-weight: 700; cursor: pointer;
    font-size: 0.94rem;
    transition: all var(--trans-bounce);
    box-shadow: 0 8px 20px rgba(233,75,111,0.25);
  }
  .admin-btn:hover {
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 12px 30px rgba(233,75,111,0.4);
  }
  .admin-btn.danger {
    background: linear-gradient(135deg, #ef4444, #dc2626);
    box-shadow: 0 8px 20px rgba(239,68,68,0.25);
  }
  .admin-btn.danger:hover {
    box-shadow: 0 12px 30px rgba(239,68,68,0.4);
  }
  .admin-btn.secondary {
    background: var(--bg2); color: var(--primary-dark);
    box-shadow: none;
    border: 2px solid var(--border);
  }

  .admin-list {
    display: flex; flex-direction: column;
    gap: 10px; margin-top: 15px;
    max-height: 240px; overflow-y: auto;
    padding-right: 4px;
  }
  .admin-list::-webkit-scrollbar { width: 6px; }
  .admin-list::-webkit-scrollbar-thumb {
    background: var(--border); border-radius: 3px;
  }
  .admin-list-item {
    background: var(--bg2);
    padding: 13px 16px;
    border-radius: var(--radius-sm);
    display: flex;
    justify-content: space-between;
    align-items: center; gap: 10px;
    font-size: 0.88rem;
    border: 2px solid var(--border-soft);
    transition: all var(--trans-fast);
    animation: cardIn 0.4s ease;
  }
  .admin-list-item:hover {
    border-color: var(--primary);
    transform: translateX(-3px);
  }
  .admin-list-item .txt {
    flex: 1; word-break: break-word;
    color: var(--text);
  }
  .admin-list-item .del {
    background: linear-gradient(135deg, #ef4444, #dc2626);
    color: white; border: none;
    border-radius: var(--radius-sm);
    padding: 6px 13px;
    cursor: pointer; font-family: inherit;
    font-weight: 700; font-size: 0.78rem;
    transition: all var(--trans-fast);
  }
  .admin-list-item .del:hover {
    transform: scale(1.08);
  }

  /* Theme Picker */
  .theme-picker {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(105px, 1fr));
    gap: 10px;
  }
  .theme-opt {
    padding: 16px 12px;
    border-radius: var(--radius);
    border: 3px solid transparent;
    cursor: pointer;
    font-family: inherit;
    font-weight: 700; font-size: 0.83rem;
    transition: all var(--trans-bounce);
    color: white;
    text-shadow: 0 1px 3px rgba(0,0,0,0.4);
    position: relative;
    overflow: hidden;
  }
  .theme-opt::after {
    content: ''; position: absolute;
    inset: 0; border: 3px solid transparent;
    border-radius: var(--radius);
    transition: all var(--trans);
  }
  .theme-opt:hover {
    transform: scale(1.06) translateY(-3px);
    box-shadow: var(--shadow);
  }
  .theme-opt.active {
    border-color: var(--primary);
    transform: scale(1.05);
    box-shadow: 0 0 0 3px var(--primary), var(--shadow);
  }
  .theme-opt.active::after {
    border-color: rgba(255,255,255,0.5);
  }

  .theme-opt[data-theme="light"] { background: linear-gradient(135deg, #fff7f4, #e94b6f); color: #4a1e2e; text-shadow: none; }
  .theme-opt[data-theme="dark"] { background: linear-gradient(135deg, #1a0f1c, #ff6b9d); }
  .theme-opt[data-theme="ocean"] { background: linear-gradient(135deg, #3b82c4, #f4a261); }
  .theme-opt[data-theme="forest"] { background: linear-gradient(135deg, #2d8b4a, #d4a373); }
  .theme-opt[data-theme="sunset"] { background: linear-gradient(135deg, #f97316, #e94b6f); }
  .theme-opt[data-theme="lavender"] { background: linear-gradient(135deg, #9b6cd4, #e94b6f); }
  .theme-opt[data-theme="black-gold"] { background: linear-gradient(135deg, #0a0a0a, #d4a373); }
  .theme-opt[data-theme="pink-dream"] { background: linear-gradient(135deg, #ff4fa3, #b06cd4); }

  /* ==================== TOAST ==================== */
  .toast {
    position: fixed; bottom: 30px; left: 50%;
    transform: translateX(-50%) translateY(150px) scale(0.8);
    background: var(--gradient-primary);
    color: white; padding: 15px 30px;
    border-radius: 50px; font-weight: 700;
    z-index: 10000; opacity: 0;
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 0 15px 45px rgba(233,75,111,0.5);
    font-size: 0.95rem;
    pointer-events: none;
    max-width: 90vw;
    text-align: center;
  }
  .toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  /* ==================== EMPTY STATE ==================== */
  .empty-state {
    text-align: center; padding: 50px 20px;
    color: var(--text-soft);
    animation: fadeIn 0.6s ease;
  }
  .empty-state .empty-heart {
    font-size: 3rem; color: var(--border);
    margin-bottom: 15px;
    animation: heartbeat 2s infinite;
    display: inline-block;
  }
  .empty-state p { font-size: 0.95rem; }

  /* ==================== RESPONSIVE ==================== */
  @media (max-width: 700px) {
    section { padding: 55px 18px; }
    .quiz-box { padding: 32px 22px; }
    .question-text { font-size: 1.15rem; }
    .generator { padding: 45px 22px; }
    .message-display { font-size: 1.02rem; padding: 28px 20px; }
    .counter-item { min-width: 95px; padding: 20px 15px; }
    .counter-num { font-size: 1.9rem; }
    .fab-plus { bottom: 20px; left: 20px; width: 58px; height: 58px; }
    .fab-menu { bottom: 90px; left: 20px; }
    .fab-item { font-size: 0.88rem; padding: 11px 16px 11px 12px; }
    .memory-grid { gap: 7px; }
    .rps-btn { width: 88px; height: 88px; font-size: 1.9rem; }
    .admin-panel { padding: 32px 22px; }
    .form-box { padding: 32px 22px; }
    .nav-menu { width: 300px; right: -320px; padding: 80px 20px 30px; }
    .topbar { padding: 10px 15px; }
    .user-badge { padding: 5px 10px 5px 5px; font-size: 0.78rem; }
    .main-heart { width: 70px; height: 70px; }
    .main-heart::before, .main-heart::after { width: 70px; height: 70px; }
    .main-heart::before { top: -35px; }
    .main-heart::after { left: 35px; }
    header { min-height: 70vh; padding: 40px 15px; }
    .love-note-final { padding: 45px 25px; }
    .love-note-final::before { font-size: 5rem; }
  }

  @media (max-width: 400px) {
    .splash-btn { min-width: 150px; padding: 17px 30px; font-size: 1rem; }
    .rps-btn { width: 78px; height: 78px; font-size: 1.7rem; }
  }

  /* ==================== PREFERS REDUCED ==================== */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

