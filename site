  function close(){modal.classList.remove('open')}
  $('lvCalcBtn').addEventListener('click',open);$('lvClose').addEventListener('click',close);
  modal.addEventListener('pointerdown',function(e){if(e.target===modal)close()});
  addEventListener('keydown',function(e){if(e.key==='Escape')close();if(e.key==='Enter'&&modal.classList.contains('open')&&e.target.tagName==='INPUT')$('lvGo').click()});
  function hash(s){var h=2166136261;for(var i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,16777619)}return h>>>0}
  function msg(p){return p>=90?'سرنوشت شما رو برای هم ساخته! 💞':p>=75?'عاشقانه‌ترین جفتی که می‌شه تصور کرد ✨':p>=60?'خیلی بهم میاین؛ فقط کمی وقت و توجه بیشتر 🌹':p>=45?'پایه‌ی خوبی دارین، با مهربونی قوی‌تر می‌شه 🌱':'عشق فقط عدد نیست؛ با هم ثابتش کنین 💪'}
  var last='';
  $('lvGo').addEventListener('click',function(){
    var a=$('lvN1').value.trim(),b=$('lvN2').value.trim();
    if(!a||!b){toast('هر دو اسم رو بنویس');return}
    var k=[a.toLowerCase(),b.toLowerCase()].sort().join('|'),p=35+hash(k)%66;
    $('lvRes').classList.add('show');$('lvMsg').textContent=msg(p);
    last=a+' ♥ '+b+' = '+p+'٪ عشق';
    var ring=$('lvRing'),n=0,step=Math.max(1,Math.round(p/40));
    var t=setInterval(function(){n=Math.min(p,n+step);ring.style.setProperty('--p',n);$('lvPct').textContent=n+'%';if(n>=p){clearInterval(t);if(p>=80&&!calm)party()}},calm?0:30);
  });
  function party(){var r=$('lvRing').getBoundingClientRect();
    for(var i=0;i<16;i++){var h=document.createElement('span');h.className='lv-heart';h.textContent=['♥','✦','❤'][i%3];
      var a=Math.random()*6.283,m=50+Math.random()*80;
      h.style.cssText='left:'+(r.left+r.width/2)+'px;top:'+(r.top+r.height/2)+'px;--dx:'+Math.cos(a)*m+'px;--dy:'+Math.sin(a)*m+'px;--r:'+(Math.random()*180-90)+'deg;font-size:'+(14+Math.random()*14)+'px';
      document.body.appendChild(h);(function(x){setTimeout(function(){x.remove()},950)})(h)}}
  $('lvCopy').addEventListener('click',function(){
    try{navigator.clipboard.writeText(last).then(function(){toast('کپی شد')},function(){toast('کپی نشد')})}catch(e){toast('کپی نشد')}
  });
})();
</script>

</body>
</html>
