let memoryCards = [], flipped = [], matched = 0, moves = 0, lock = false;
function initMemory() {
  const symbols = ['♥', '★', '♦', '♣', '♪', '☀', '☁', '✿'];
  memoryCards = [...symbols, ...symbols].sort(() => Math.random() - 0.5);
  flipped = []; matched = 0; moves = 0; lock = false;
  $('memoryGrid').innerHTML = memoryCards.map((s, i) =>
    `<div class="memory-card" data-idx="${i}" onclick="flipMemory(${i})"></div>`
  ).join('');
  $('memoryStatus').textContent = 'حرکت: 0';
}
function flipMemory(i) {
  if (lock) return;
  const card = document.querySelector(`.memory-card[data-idx="${i}"]`);
  if (!card || card.classList.contains('flipped') || card.classList.contains('matched')) return;
  card.classList.add('flipped');
  card.textContent = memoryCards[i];
  flipped.push(i);
  if (flipped.length === 2) {
    moves++;
    $('memoryStatus').textContent = 'حرکت: ' + moves;
    lock = true;
    const [a, b] = flipped;
    if (memoryCards[a] === memoryCards[b]) {
      setTimeout(() => {
        document.querySelector(`.memory-card[data-idx="${a}"]`).classList.add('matched');
        document.querySelector(`.memory-card[data-idx="${b}"]`).classList.add('matched');
        matched++;
        flipped = [];
        lock = false;
        if (matched === 8) {
          setTimeout(() => showToast(`بردی! تو ${moves} حرکت`), 300);
        }
      }, 400);
    } else {
      setTimeout(() => {
        document.querySelector(`.memory-card[data-idx="${a}"]`).classList.remove('flipped');
        document.querySelector(`.memory-card[data-idx="${a}"]`).textContent = '';
        document.querySelector(`.memory-card[data-idx="${b}"]`).classList.remove('flipped');
        document.querySelector(`.memory-card[data-idx="${b}"]`).textContent = '';
        flipped = []; lock = false;
      }, 850);
    }
  }
}
initMemory();

/* ==================== TTT ==================== */
let tttBoard = ['','','','','','','','',''];
let tttGameOver = false;
const TTT_LINES = [[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]];

function initTTT() {
  tttBoard = ['','','','','','','','',''];
  tttGameOver = false;
  $('tttStatus').textContent = 'نوبت توئه';
  renderTTT();
}
function renderTTT() {
  $('tttBoard').innerHTML = tttBoard.map((v, i) =>
    `<button class="ttt-cell ${v ? 'taken' : ''}" onclick="tttClick(${i})">${v}</button>`
  ).join('');
}
function tttClick(i) {
  if (tttGameOver || tttBoard[i] !== '') return;
  tttBoard[i] = '♥';
  let w = checkTTTWin();
  if (w) { endTTT(w); return; }
  if (!tttBoard.includes('')) { endTTT('draw'); return; }
  $('tttStatus').textContent = 'کامپیوتر داره فکر می‌کنه...';
  renderTTT();
  setTimeout(() => {
    const best = bestTTTMove();
    tttBoard[best] = '★';
    renderTTT();
    w = checkTTTWin();
    if (w) { endTTT(w); return; }
    if (!tttBoard.includes('')) { endTTT('draw'); return; }
    $('tttStatus').textContent = 'نوبت توئه';
  }, 400);
}
function bestTTTMove() {
  for (const [a,b,c] of TTT_LINES) {
    const line = [tttBoard[a], tttBoard[b], tttBoard[c]];
    if (line.filter(x => x === '★').length === 2 && line.includes('')) {
      return [a,b,c][line.indexOf('')];
    }
  }
  for (const [a,b,c] of TTT_LINES) {
    const line = [tttBoard[a], tttBoard[b], tttBoard[c]];
    if (line.filter(x => x === '♥').length === 2 && line.includes('')) {
      return [a,b,c][line.indexOf('')];
    }
  }
  if (tttBoard[4] === '') return 4;
  const corners = [0,2,6,8].filter(i => tttBoard[i] === '');
  if (corners.length) return corners[Math.floor(Math.random() * corners.length)];
  const empty = tttBoard.map((v,i) => v === '' ? i : -1).filter(i => i >= 0);
  return empty[Math.floor(Math.random() * empty.length)];
}
function checkTTTWin() {
  for (const [a,b,c] of TTT_LINES) {
    if (tttBoard[a] && tttBoard[a] === tttBoard[b] && tttBoard[a] === tttBoard[c]) return tttBoard[a];
  }
  return null;
}
function endTTT(winner) {
  tttGameOver = true;
  const status = $('tttStatus');
  if (winner === '♥') status.textContent = 'بردی! آفرین';
  else if (winner === '★') status.textContent = 'باختی. دوباره تلاش کن';
  else status.textContent = 'مساوی شد';
  for (const [a,b,c] of TTT_LINES) {
    if (tttBoard[a] && tttBoard[a] === tttBoard[b] && tttBoard[a] === tttBoard[c]) {
      const cells = document.querySelectorAll('.ttt-cell');
      cells[a].classList.add('win');
      cells[b].classList.add('win');
      cells[c].classList.add('win');
    }
  }
}
initTTT();

